
 //@version=6
indicator("Binary Auto Scanner V4 - 23 Forex",
     overlay=true, dynamic_requests=true)

// =======================================
// SETTINGS
// =======================================
expiry = input.int(2, "Expiry (minutes)",
     options=[1, 2, 3])

threshold = input.int(5, "Minimum filters",
     minval=4, maxval=7)

scanTF = input.timeframe("1", "Scan timeframe")

showWait = input.bool(true, "Show WAIT pairs")
enableAlerts = input.bool(true, "Enable alerts")

// =======================================
// FOREX PAIRS
// =======================================
var array<string> pairs = array.from(
     "OANDA:EURUSD",
     "OANDA:GBPUSD",
     "OANDA:USDJPY",
     "OANDA:USDCHF",
     "OANDA:USDCAD",
     "OANDA:AUDUSD",
     "OANDA:NZDUSD",
     "OANDA:EURGBP",
     "OANDA:EURJPY",
     "OANDA:EURCHF",
     "OANDA:EURAUD",
     "OANDA:EURCAD",
     "OANDA:GBPJPY",
     "OANDA:GBPCHF",
     "OANDA:GBPAUD",
     "OANDA:GBPCAD",
     "OANDA:AUDJPY",
     "OANDA:AUDCAD",
     "OANDA:AUDNZD",
     "OANDA:NZDJPY",
     "OANDA:NZDCAD",
     "OANDA:CADJPY",
     "OANDA:CHFJPY"
)

// =======================================
// ANALYSIS FUNCTION
// =======================================
f_analysis() =>
    // Trend
    ema9 = ta.ema(close, 9)
    ema21 = ta.ema(close, 21)
    ema50 = ta.ema(close, 50)

    bullTrend = ema9 > ema21 and ema21 > ema50
    bearTrend = ema9 < ema21 and ema21 < ema50

    // RSI
    r = ta.rsi(close, 14)
    bullRSI = r > 52 and r < 70
    bearRSI = r < 48 and r > 30

    // MACD
    [macdLine, signalLine, hist] =
         ta.macd(close, 12, 26, 9)

    bullMACD = hist > 0
    bearMACD = hist < 0

    // Support / Resistance
    support = ta.lowest(low[1], 20)
    resistance = ta.highest(high[1], 20)
    width = math.max(resistance - support,
         syminfo.mintick)

    bullSR = close > support + width * 0.35 and
         close < resistance + width * 0.85

    bearSR = close < resistance - width * 0.35 and
         close > support + width * 0.15

    // Bollinger Bands
    basis = ta.sma(close, 20)
    dev = ta.stdev(close, 20) * 2
    upper = basis + dev
    lower = basis - dev

    bullBB = close > basis and close < upper
    bearBB = close < basis and close > lower

    // Candle patterns
    prevBear = close[1] < open[1]
    prevBull = close[1] > open[1]

    bullEngulf = prevBear and close > open and
         open <= close[1] and close >= open[1]

    bearEngulf = prevBull and close < open and
         open >= close[1] and close <= open[1]

    body = math.abs(close - open)
    candleRange = math.max(high - low,
         syminfo.mintick)

    upperWick = high - math.max(open, close)
    lowerWick = math.min(open, close) - low

    bullPin = lowerWick >= body * 2 and
         upperWick <= candleRange * 0.25 and
         close > low + candleRange * 0.55

    bearPin = upperWick >= body * 2 and
         lowerWick <= candleRange * 0.25 and
         close < low + candleRange * 0.45

    bullCandle = bullEngulf or bullPin
    bearCandle = bearEngulf or bearPin

    // ATR volatility
    atrValue = ta.atr(14)
    atrRatio = atrValue / close

    atrOK = atrRatio > 0.00004 and
         atrRatio < 0.008

    // Scores
    up = (
         (bullTrend ? 1 : 0) +
         (bullRSI ? 1 : 0) +
         (bullMACD ? 1 : 0) +
         (bullSR ? 1 : 0) +
         (bullBB ? 1 : 0) +
         (bullCandle ? 1 : 0) +
         (atrOK ? 1 : 0)
         )

    down = (
         (bearTrend ? 1 : 0) +
         (bearRSI ? 1 : 0) +
         (bearMACD ? 1 : 0) +
         (bearSR ? 1 : 0) +
         (bearBB ? 1 : 0) +
         (bearCandle ? 1 : 0) +
         (atrOK ? 1 : 0)
         )

    direction = atrOK and up >= threshold and
         up > down ? 1 :
         atrOK and down >= threshold and
         down > up ? -1 : 0

    // Encode matched filters as bits
    bullBits = (
         (bullTrend ? 1 : 0) +
         (bullRSI ? 2 : 0) +
         (bullMACD ? 4 : 0) +
         (bullSR ? 8 : 0) +
         (bullBB ? 16 : 0) +
         (bullCandle ? 32 : 0) +
         (atrOK ? 64 : 0)
         )

    bearBits = (
         (bearTrend ? 1 : 0) +
         (bearRSI ? 2 : 0) +
         (bearMACD ? 4 : 0) +
         (bearSR ? 8 : 0) +
         (bearBB ? 16 : 0) +
         (bearCandle ? 32 : 0) +
         (atrOK ? 64 : 0)
         )

    bits = direction == 1 ? bullBits :
         direction == -1 ? bearBits : 0

    // Closed candle only
    [direction, up, down, r, close,
         atrValue, bits, time]

// =======================================
// REASONS
// =======================================
f_hasBit(int bits, int bit) =>
    int(math.floor(bits / bit)) % 2 == 1

f_reasons(int bits) =>
    string result = ""

    if f_hasBit(bits, 1)
        result += "EMA "

    if f_hasBit(bits, 2)
        result += "RSI "

    if f_hasBit(bits, 4)
        result += "MACD "

    if f_hasBit(bits, 8)
        result += "S/R "

    if f_hasBit(bits, 16)
        result += "BB "

    if f_hasBit(bits, 32)
        result += "Candle "

    if f_hasBit(bits, 64)
        result += "ATR "

    result == "" ? "-" : result

// =======================================
// TABLE
// =======================================
var table dashboard = table.new(
     position.top_right, 7, 25,
     border_width=1)

if barstate.islast
    table.cell(dashboard, 0, 0, "PAIR",
         bgcolor=color.rgb(25, 43, 65),
         text_color=color.white)

    table.cell(dashboard, 1, 0, "SIGNAL",
         bgcolor=color.rgb(25, 43, 65),
         text_color=color.white)

    table.cell(dashboard, 2, 0, "UP",
         bgcolor=color.rgb(25, 43, 65),
         text_color=color.white)

    table.cell(dashboard, 3, 0, "DOWN",
         bgcolor=color.rgb(25, 43, 65),
         text_color=color.white)

    table.cell(dashboard, 4, 0, "RSI",
         bgcolor=color.rgb(25, 43, 65),
         text_color=color.white)

    table.cell(dashboard, 5, 0, "MIN",
         bgcolor=color.rgb(25, 43, 65),
         text_color=color.white)

    table.cell(dashboard, 6, 0, "REASONS",
         bgcolor=color.rgb(25, 43, 65),
         text_color=color.white)

// =======================================
// SCAN 23 PAIRS
// =======================================
for i = 0 to array.size(pairs) - 1
    symbol = array.get(pairs, i)

    [dirRaw, upRaw, downRaw, rRaw,
         priceRaw, atrRaw, bitsRaw, timeRaw] =
         request.security(
             symbol,
             scanTF,
             f_analysis(),
             gaps=barmerge.gaps_off,
             lookahead=barmerge.lookahead_off,
             ignore_invalid_symbol=true,
             calc_bars_count=150
         )

    // Use previous completed 1m candle on
    // a 1-minute chart. This avoids using
    // a still-forming candle for alerts.
    dir = dirRaw[1]
    up = upRaw[1]
    down = downRaw[1]
    r = rRaw[1]
    price = priceRaw[1]
    atrValue = atrRaw[1]
    bits = bitsRaw[1]
    signalTime = timeRaw[1]

    isCall = dir == 1
    isPut = dir == -1
    isWait = dir == 0

    signalText = isCall ? "CALL" :
         isPut ? "PUT" : "WAIT"

    signalColor = isCall ? color.lime :
         isPut ? color.red : color.gray

    pairName = str.replace(symbol, "OANDA:", "")

    reasonText = na(bits) ? "-" :
         f_reasons(bits)

    row = i + 1

    if barstate.islast
        visible = showWait or not isWait
        bg = visible ? color.rgb(17, 28, 43) :
             color.rgb(12, 18, 27)

        table.cell(dashboard, 0, row,
             pairName, bgcolor=bg,
             text_color=color.white)

        table.cell(dashboard, 1, row,
             visible ? signalText : "-",
             bgcolor=bg,
             text_color=signalColor)

        table.cell(dashboard, 2, row,
             str.tostring(up),
             bgcolor=bg, text_color=color.white)

        table.cell(dashboard, 3, row,
             str.tostring(down),
             bgcolor=bg, text_color=color.white)

        table.cell(dashboard, 4, row,
             str.tostring(r, "#.0"),
             bgcolor=bg, text_color=color.white)

        table.cell(dashboard, 5, row,
             str.tostring(expiry),
             bgcolor=bg, text_color=color.white)

        table.cell(dashboard, 6, row,
             visible ? reasonText : "-",
             bgcolor=bg, text_color=color.white)

    // New closed-candle signal
    newSignal = not na(signalTime) and
         signalTime != signalTime[1] and
         (isCall or isPut)

    if enableAlerts and barstate.isconfirmed and newSignal
        message = (
             "Binary Scanner V4 | " +
             pairName + " | " +
             signalText + " | " +
             str.tostring(expiry) + " min | " +
             "Price: " + str.tostring(price) +
             " | UP: " + str.tostring(up) +
             " | DOWN: " + str.tostring(down) +
             " | Reasons: " + reasonText
             )

        alert(message, alert.freq_all)

// =======================================
// CHART LABEL
// =======================================
plot(ta.ema(close, 9),
     "EMA 9", color=color.lime)

plot(ta.ema(close, 21),
     "EMA 21", color=color.orange)

plot(ta.ema(close, 50),
     "EMA 50", color=color.blue)
